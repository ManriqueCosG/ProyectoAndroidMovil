        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_principal</item>
    </style>

    <!-- Estilo para las etiquetas de los campos -->
    <style name="EstiloEtiqueta">
        <item name="android:textSize">12sp</item>
